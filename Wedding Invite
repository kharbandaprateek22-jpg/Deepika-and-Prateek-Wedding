    <textarea id="msg" rows="3" placeholder="Wishes, dietary needs, anything we should know"></textarea>

    <button type="submit" class="btn-submit">SEND MY RSVP</button>
    <p class="form-note">Your RSVP opens in WhatsApp, ready to send to the family.</p>
  </form>

  <div class="thanks" id="thanks" role="status">
    <h3>Thank you!</h3>
    <p class="subtitle" style="font-size:20px">If WhatsApp did not open, tap the button below to send your RSVP.</p>
    <a id="waLink" href="#" target="_blank" rel="noopener noreferrer">OPEN WHATSAPP</a>
  </div>
