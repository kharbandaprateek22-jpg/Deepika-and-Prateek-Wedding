</section>

<!-- LOCATION -->
<section class="location">
  <div class="section-heading">The Wedding Destination</div>
  <div class="gold-line"></div>
  <div style="font-size:45px">📍</div>
  <h3>Sinclairs Retreat Resort</h3>
  <p class="subtitle">Udaipur, Rajasthan, India</p>
  <a class="map-button" target="_blank" rel="noopener noreferrer"
     href="https://www.google.com/maps/place/Sinclairs+Palace+Retreat+Udaipur/@24.8472766,73.3687716,38175m/data=!3m1!1e3!4m13!1m2!2m1!1ssinclairs+retreat+resort+udaipur!3m9!1s0x39680f317d819f2f:0x962a238edfa1c657!5m2!4m1!1i2!8m2!3d24.8472766!4d73.6571627!15sCiBzaW5jbGFpcnMgcmV0cmVhdCByZXNvcnQgdWRhaXB1ciIDiAEBWiIiIHNpbmNsYWlycyByZXRyZWF0IHJlc29ydCB1ZGFpcHVykgEFaG90ZWyaAURDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrVlZWWVVsZE5WM2hOVjJ4S2VHRXpTWGhWTWxKT1dsWldOVTVHUlJBQuABAPoBBAgAEEY!16s%2Fg%2F11x34j8z54?entry=ttu">
