<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Prateek & Deepika | Wedding Invitation</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Great+Vibes&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--gold:#d5ad65;--dark-gold:#a77c38;--maroon:#601c2b;--cream:#fff8ed;--ink:#54202a}
html{scroll-behavior:smooth}
body{background:var(--cream);color:var(--ink);font-family:'Poppins',sans-serif;overflow-x:hidden;line-height:1.6}
section{padding:85px 20px;text-align:center}
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--gold);outline-offset:3px}

/* OPENING */
#opening{position:fixed;inset:0;z-index:1000;background:radial-gradient(circle,#852c3d,#3c101e);display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;transition:1s ease;padding:20px}
#opening.hide{opacity:0;visibility:hidden}
.opening-title{font-family:'Cormorant Garamond',serif;color:#f8dfad;font-size:24px;letter-spacing:5px;margin-bottom:35px}
.heart{font-size:100px;cursor:pointer;animation:heartbeat 1.3s infinite;filter:drop-shadow(0 0 25px #ffb4b4);background:none;border:0;line-height:1}
.tap-text{color:#f6dfba;margin-top:35px;letter-spacing:3px;font-size:12px;animation:blink 1.5s infinite}
@keyframes heartbeat{0%,100%{transform:scale(1)}50%{transform:scale(1.18)}}
@keyframes blink{50%{opacity:.4}}
#invitation{display:none;animation:fadeIn 2s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}

/* HERO */
.hero{min-height:100vh;background:linear-gradient(rgba(48,10,20,.72),rgba(48,10,20,.82)),url('https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1800&q=85') center/cover;display:flex;align-items:center;justify-content:center;text-align:center;padding:45px 20px;color:#fff}
.hero-content{max-width:850px;border:1px solid rgba(225,190,125,.8);padding:55px 30px;outline:1px solid rgba(225,190,125,.35);outline-offset:9px}
.small-heading{font-size:12px;letter-spacing:5px;color:#edcf91;text-transform:uppercase}
.hero h1{font-family:'Great Vibes',cursive;font-size:clamp(55px,10vw,100px);font-weight:400;color:#f5d79d;margin:20px 0 10px;line-height:1.15}
.amp{font-family:'Cormorant Garamond',serif;color:#fff;font-size:42px;line-height:1}
.parents{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:21px;color:#f6e6c8;line-height:1.5}
.parents b{display:block;font-style:normal;font-weight:600;letter-spacing:1px;color:#f5d79d;font-size:23px}
.hero-date{font-family:'Cormorant Garamond',serif;font-size:25px;letter-spacing:4px;margin-top:10px}
.hero-location{margin-top:12px;font-size:13px;letter-spacing:2px}
.btn-rsvp{display:inline-block;margin-top:30px;padding:14px 34px;background:var(--gold);color:#3c101e;text-decoration:none;font-weight:600;font-size:13px;letter-spacing:2px;transition:.3s}
.btn-rsvp:hover{background:#f5d79d}

.section-heading{font-family:'Great Vibes',cursive;font-size:55px;color:var(--maroon);margin-bottom:10px;line-height:1.2}
.gold-line{width:85px;height:2px;background:var(--gold);margin:20px auto 30px}
.subtitle{font-family:'Cormorant Garamond',serif;font-size:23px;line-height:1.7;max-width:720px;margin:auto;color:#75515a}

/* FAMILIES */
.families{background:#f7ecdf}
.family-container{display:flex;justify-content:center;flex-wrap:wrap;gap:60px;margin-top:35px}
.family{min-width:240px;max-width:320px}
.family h3{font-family:'Cormorant Garamond',serif;font-size:32px;color:var(--dark-gold)}
.family .who{font-family:'Cormorant Garamond',serif;font-size:21px;font-style:italic;margin-top:8px;color:#75515a}
.family p{margin-top:10px;font-size:12px;letter-spacing:3px}

/* COUNTDOWN */
.countdown-section{background:var(--maroon);color:#fff}
.countdown-section .section-heading{color:#f3d59f}
.countdown{display:flex;justify-content:center;gap:15px;flex-wrap:wrap;margin-top:35px}
.time-box{border:1px solid #caa35f;padding:22px 15px;min-width:90px;background:rgba(255,255,255,.04)}
.time-box span{display:block;font-family:'Cormorant Garamond',serif;font-size:42px;color:#f2d39a;line-height:1.1}
.time-box small{font-size:10px;letter-spacing:2px}

/* EVENTS: each function has its own theme */
.events-intro{background:var(--cream);padding-bottom:50px}
.event-band{padding:80px 20px;position:relative;overflow:hidden}
.event-card{max-width:680px;margin:auto;padding:45px 28px;border:1px solid var(--bd);outline:1px solid var(--bd2);outline-offset:8px;background:var(--cardbg);position:relative;z-index:1;text-align:center}
.event-band::before,.event-band::after{content:attr(data-deco);position:absolute;font-size:120px;opacity:.13;line-height:1}
.event-band::before{top:10px;left:2%}
.event-band::after{bottom:10px;right:2%;transform:rotate(180deg)}
.event-icon{font-size:38px}
.event-name{font-family:'Great Vibes',cursive;font-size:clamp(42px,8vw,60px);color:var(--title);line-height:1.2;margin:6px 0}
.event-tag{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:21px;color:var(--text)}
.event-meta{display:flex;justify-content:center;flex-wrap:wrap;gap:12px 32px;margin-top:22px;font-size:14px;color:var(--text)}
.event-meta b{display:block;font-size:11px;letter-spacing:2px;font-weight:500;color:var(--title);text-transform:uppercase}
.dress{margin-top:22px;display:inline-block;padding:9px 20px;border:1px dashed var(--title);color:var(--title);font-size:13px}
.event-extra{margin-top:18px;font-family:'Cormorant Garamond',serif;font-size:22px;color:var(--text)}

.t-mehndi{--bd:#7f8f2e;--bd2:rgba(127,143,46,.4);--cardbg:rgba(255,255,255,.55);--title:#4f5f12;--text:#4b4a1c;background:linear-gradient(135deg,#ffe27a,#ffc83d 55%,#e9e069)}
.t-sangeet{--bd:#e6b8ff;--bd2:rgba(230,184,255,.4);--cardbg:rgba(30,8,60,.45);--title:#ffd6f0;--text:#f3e6ff;background:radial-gradient(circle at 20% 20%,#7a2fc0,#3a1070 60%,#1f0848)}
.t-wedding{--bd:#e1be7d;--bd2:rgba(225,190,125,.4);--cardbg:rgba(60,12,24,.55);--title:#f4d8a5;--text:#fbe9cd;background:linear-gradient(rgba(150,28,48,.88),rgba(90,14,30,.92)),url('https://images.unsplash.com/photo-1606800052052-a08af7148866?auto=format&fit=crop&w=1600&q=85') center/cover}
.t-reception{--bd:#c9a45a;--bd2:rgba(201,164,90,.4);--cardbg:rgba(5,12,30,.5);--title:#e9cd8e;--text:#dbe3f5;background:radial-gradient(circle at 80% 10%,#26407a,#0d1b3d 55%,#050b1c)}

/* LOCATION */
.location{background:#f7ecdf}
.location h3{font-family:'Cormorant Garamond',serif;font-size:34px;margin:15px 0 10px}
.map-button{display:inline-block;margin-top:25px;padding:15px 30px;border:1px solid var(--dark-gold);background:var(--maroon);color:#fff;text-decoration:none;letter-spacing:2px;font-size:12px;transition:.3s}
.map-button:hover{background:var(--dark-gold)}

/* RSVP */
.rsvp{background:linear-gradient(180deg,var(--cream),#f4e3cc)}
.rsvp-form{max-width:560px;margin:35px auto 0;text-align:left;background:#fff;padding:35px 28px;border:1px solid #e6d3b2;box-shadow:0 10px 40px rgba(96,28,43,.1)}
.rsvp-form label,.rsvp-form legend{display:block;font-size:12px;letter-spacing:1.5px;font-weight:500;color:var(--maroon);margin:18px 0 6px;text-transform:uppercase}
.rsvp-form input[type=text],.rsvp-form input[type=tel],.rsvp-form input[type=number],.rsvp-form select,.rsvp-form textarea{width:100%;padding:12px 14px;border:1px solid #d9c3a0;background:#fffdf8;font:inherit;font-size:15px;color:var(--ink);border-radius:2px}
.rsvp-form fieldset{border:0}
.choice{display:flex;gap:12px;flex-wrap:wrap}
.choice label{display:flex;align-items:center;gap:8px;margin:0;padding:10px 14px;border:1px solid #d9c3a0;font-size:13px;letter-spacing:0;text-transform:none;font-weight:400;color:var(--ink);cursor:pointer;background:#fffdf8}
.choice input{accent-color:var(--maroon)}
.choice label:has(input:checked){border-color:var(--maroon);background:#fbeaea}
.btn-submit{width:100%;margin-top:26px;padding:15px;background:var(--maroon);color:#fff;border:0;font:inherit;font-weight:600;font-size:13px;letter-spacing:2px;cursor:pointer;transition:.3s}
.btn-submit:hover{background:var(--dark-gold)}
.form-note{margin-top:14px;font-size:12px;color:#8a6d6d;text-align:center}
.thanks{display:none;max-width:560px;margin:35px auto 0;padding:35px;background:#fff;border:1px solid var(--gold)}
.thanks h3{font-family:'Great Vibes',cursive;font-size:44px;color:var(--maroon);font-weight:400}
.thanks a{display:inline-block;margin-top:18px;padding:12px 24px;background:#25a244;color:#fff;text-decoration:none;font-size:13px;letter-spacing:1px}

footer{background:#42121e;color:#f3d59f;text-align:center;padding:65px 20px}
footer h2{font-family:'Great Vibes',cursive;font-size:58px;font-weight:400;line-height:1.2}
footer p{margin-top:15px;font-size:12px;letter-spacing:2px}

@media(max-width:600px){
.hero-content{padding:45px 15px}.hero-date{font-size:19px}.section-heading{font-size:44px}
.time-box{min-width:75px;padding:15px 8px}.time-box span{font-size:32px}.subtitle{font-size:21px}
.event-card{padding:38px 18px}.event-band::before,.event-band::after{font-size:80px}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}html{scroll-behavior:auto}}
</style>
</head>
<body>

<div id="opening">
  <div class="opening-title">YOU ARE CORDIALLY INVITED</div>
