  <form class="rsvp-form" id="rsvpForm">
    <label for="name">Your full name</label>
    <input type="text" id="name" required placeholder="e.g. Rohan Sharma">

    <label for="phone">Phone / WhatsApp</label>
    <input type="tel" id="phone" required placeholder="+91 98765 43210">

    <fieldset>
      <legend>Will you attend?</legend>
      <div class="choice">
        <label><input type="radio" name="attend" value="Yes, joyfully accepts" checked> Joyfully accept</label>
        <label><input type="radio" name="attend" value="Sadly, cannot make it"> Regretfully decline</label>
      </div>
    </fieldset>

    <div id="attendFields">
      <label for="guests">Number of guests (including you)</label>
      <input type="number" id="guests" min="1" max="10" value="1">

      <fieldset>
        <legend>Which functions will you join?</legend>
        <div class="choice">
          <label><input type="checkbox" name="fn" value="Mehndi & Haldi" checked> 🌼 Mehndi &amp; Haldi</label>
          <label><input type="checkbox" name="fn" value="Sangeet & Sagan" checked> ✨ Sangeet &amp; Sagan</label>
          <label><input type="checkbox" name="fn" value="Wedding Ceremony" checked> 🙏 Wedding</label>
          <label><input type="checkbox" name="fn" value="Reception" checked> 🥂 Reception</label>
        </div>
      </fieldset>

