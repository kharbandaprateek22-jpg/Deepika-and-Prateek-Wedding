  </div>
</div>

<!-- STAY -->
<section>
  <div class="section-heading">Your Stay Awaits</div>
  <div class="gold-line"></div>
  <p class="subtitle">
    We look forward to welcoming you to our wedding celebrations in the beautiful city of Udaipur.
    <br><br>
    <strong>Check-in: 13 February 2027</strong><br>
    Around 10:00 AM – 12:00 PM
