<script>
// ===== SETTINGS: change this before sharing =====
// WhatsApp number with country code, no + or spaces (e.g. 919876543210)
const WHATSAPP_NUMBER = "91XXXXXXXXXX";

function openInvitation(){
  const o = document.getElementById('opening');
  o.classList.add('hide');
  setTimeout(()=>{
    o.style.display='none';
    document.getElementById('invitation').style.display='block';
    window.scrollTo(0,0);
  },1000);
}

// Countdown (IST)
const weddingDate = new Date("2027-02-14T12:00:00+05:30").getTime();
function pad(n){return String(n).padStart(2,'0')}
function updateCountdown(){
  let d = weddingDate - Date.now();
  if(d < 0) d = 0;
  document.getElementById('days').innerText = pad(Math.floor(d/864e5));
  document.getElementById('hours').innerText = pad(Math.floor(d%864e5/36e5));
  document.getElementById('minutes').innerText = pad(Math.floor(d%36e5/6e4));
  document.getElementById('seconds').innerText = pad(Math.floor(d%6e4/1e3));
}
updateCountdown();
setInterval(updateCountdown,1000);

// RSVP: hide extra fields if declining
const form = document.getElementById('rsvpForm');
const attendFields = document.getElementById('attendFields');
form.addEventListener('change', ()=>{
  const yes = form.attend.value.startsWith('Yes');
  attendFields.style.display = yes ? 'block' : 'none';
});

// RSVP: build WhatsApp message
form.addEventListener('submit', e=>{
  e.preventDefault();
  const v = id => document.getElementById(id).value.trim();
  const yes = form.attend.value.startsWith('Yes');
  let t = "*RSVP: Prateek & Deepika Wedding*\n";
  t += "Name: " + v('name') + "\n";
  t += "Phone: " + v('phone') + "\n";
  t += "Response: " + form.attend.value + "\n";
  if(yes){
    const fns = [...form.querySelectorAll('input[name=fn]:checked')].map(i=>i.value).join(', ') || 'None selected';
    t += "Guests: " + v('guests') + "\n";
    t += "Functions: " + fns + "\n";
    t += "Stay: " + v('stay') + "\n";
    if(v('arrival')) t += "Arrival: " + v('arrival') + "\n";
  }
  if(v('msg')) t += "Message: " + v('msg');
  const url = "https://wa.me/" + WHATSAPP_NUMBER + "?text=" + encodeURIComponent(t);
  document.getElementById('waLink').href = url;
  form.style.display = 'none';
  document.getElementById('thanks').style.display = 'block';
  window.open(url,'_blank');
});
</script>
